# Copy to .env for local development. Never commit .env. Production values go in Render.

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=            # comma-separated Telegram user IDs
FLUX_WEBAPP_URL=               # public https:// URL of the app (or RENDER_EXTERNAL_URL)

# --- Database (leave blank to use SQLite) ----------------------------------
SUPABASE_DB_URL=               # or DATABASE_URL
DATABASE_PATH=./flux.db

# --- Supplier ---------------------------------------------------------------
SUPPLIER_API_KEY=
SUPPLIER_API_BASE=
SUPPLIER_LOW_BALANCE=0
CATALOG_SYNC_MINUTES=30

# --- Payments and operations -------------------------------------------------
PAYMENT_TTL_MINUTES=20
OPS_STUCK_MINUTES=30
OPS_TOPUP_STALE_HOURS=12
OPS_ALERT_COOLDOWN_MINUTES=60

# --- Other ------------------------------------------------------------------
BRAND_NAME=FLUX
FLUX_DEMO_MODE=false           # true ONLY for local development. Never in production.
